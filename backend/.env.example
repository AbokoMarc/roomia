# Copier ce fichier en ".env" en local et remplir les vraies valeurs.
# Ne jamais committer le ".env" réel — il est déjà exclu par .gitignore.
# En production (Render, etc.), ces variables se définissent dans le tableau de bord d'hébergement, pas dans ce fichier.

PORT=4000

# Obligatoire : secret pour signer les sessions (JWT). Générer avec : openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_secret

# Compte admin créé automatiquement au premier démarrage (ou promu si l'email existe déjà)
ADMIN_EMAIL=admin@roomia.fr
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=Administrateur Roomia

# Base de données Turso (SQLite hébergé, gratuit et persistant).
# Laisser VIDE en local : le backend utilise alors un simple fichier SQLite (backend/data/roomia.db), sans compte Turso.
# En production, remplir avec les valeurs données par `turso db show` / `turso db tokens create` (voir README).
# TURSO_DATABASE_URL=libsql://ton-alias-ton-compte.turso.io
# TURSO_AUTH_TOKEN=eyJ...

# Neero : pas de variable d'environnement — le compte affiché aux clients se configure directement
# dans l'admin (Paiements → Compte Neero), pas ici. Paiement manuel : le client envoie, colle une
# référence, tu vérifies et valides dans l'admin.

# PayPal — paiement automatique (débit immédiat, confirmation instantanée).
# Laisser VIDE : PayPal est simplement désactivé, les autres méthodes fonctionnent normalement.
# Récupère Client ID / Secret sur developer.paypal.com (Apps & Credentials).
# PAYPAL_ENV=sandbox pour tester (par défaut), PAYPAL_ENV=live pour du vrai argent.
# PAYPAL_WEBHOOK_ID vient de developer.paypal.com → ton app → Webhooks (après avoir ajouté l'URL de webhook).
# Même une fois configuré, PayPal reste caché côté client tant que tu ne l'actives pas dans
# Admin → Paiements → PayPal (case à cocher) — désactivé par défaut.
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_WEBHOOK_ID=...
# PAYPAL_ENV=sandbox

# Binance Pay — paiement crypto automatique (facultatif). Laisser VIDE : la crypto utilise alors
# le wallet manuel configuré dans l'admin (Paiements → Crypto) — rien ne casse si tu ne remplis pas ça.
# ⚠️ Intégration non testée en conditions réelles — vérifie soigneusement avant d'y faire confiance (voir README).
# Récupère ces valeurs dans ton tableau de bord Binance Pay pour marchands (API Management).
# BINANCE_PAY_API_KEY=...
# BINANCE_PAY_SECRET_KEY=...
# BINANCE_PAY_CURRENCY=USDT

# Crypto (repli manuel) : pas de variable d'environnement — l'adresse wallet affichée aux clients
# se configure directement dans l'admin (Paiements → Crypto), pas ici. Paiement manuel :
# le client envoie, colle le hash de sa transaction, tu vérifies et valides dans l'admin.
