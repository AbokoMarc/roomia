# Copier ce fichier en ".env" en local et remplir les vraies valeurs.
# Ne jamais committer le ".env" réel — il est déjà exclu par .gitignore.
# En production (Render, etc.), ces variables se définissent dans le tableau de bord d'hébergement, pas dans ce fichier.

PORT=4000

# Obligatoire : secret pour signer les sessions (JWT). Générer avec : openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_secret

# Compte admin créé automatiquement au premier démarrage (ou promu si l'email existe déjà)
ADMIN_EMAIL=admin@roomia.fr
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=Administrateur Roomia

# Optionnel — chemin du fichier SQLite. Par défaut : backend/data/roomia.db
# Sur Render avec un disque persistant monté sur /app/backend/data, laisser la valeur par défaut suffit.
# DB_PATH=/app/backend/data/roomia.db
